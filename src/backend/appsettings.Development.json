{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Information",
      "Microsoft.EntityFrameworkCore.Database.Command": "Information"
    }
  },
  "SeedDemoData": true,
  "ResetDemoAdminPassword": true,
  "UseSqlite": true,
  "ConnectionStrings": {
    "SqliteConnection": "Data Source=App_Data/chessweb.db"
  },
  "Jwt": {
    "Key": "development-only-example-jwt-key-1234567890"
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:3000", "http://localhost:5173", "http://127.0.0.1:3000", "http://127.0.0.1:5173" ]
  },
  "ClamAv": {
    "Enabled": false
  },
  "Uploads": {
    "RateLimitPerMinute": 1000
  },
  "AuthRateLimit": {
    "LoginPermitsPerMinute": 1000,
    "RegistrationPermitsPerMinute": 1000
  }
}
